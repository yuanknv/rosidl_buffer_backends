<package format="3">
  <name>cuda_core_vendor</name>
  <version>0.3.1</version>
  <description>Vendored cuda-core Rust sources and their pinned dependencies.</description>
  <maintainer email="yuankunz@nvidia.com">Yuankun Zhu</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend version_gte="3.12">python3</buildtool_depend>
  <buildtool_depend version_gte="1.89">cargo</buildtool_depend>
  <buildtool_depend version_gte="1.89">rustc</buildtool_depend>
  <build_export_depend>libclang-dev</build_export_depend>
  <build_export_depend version_gte="13">nvidia-cuda</build_export_depend>
  <exec_depend>libclang-dev</exec_depend>
